namespace INSACERMO.JointBariNuFIT
open INSACERMO.NuFIT61RealGrid

-- The published Bari 3sigma interval does not meet the B-low interval.
theorem bari_3sigma_excludes_Blow (x : Int)
    (hLow : 50 ≤ x ∧ x ≤ 400)
    (hBari : 1422 ≤ x ∧ x ≤ 3510) : False := by omega

-- The reported Bari 2sigma interval does not meet B-high.
theorem bari_2sigma_excludes_Bhigh (x : Int)
    (hHigh : 3200 ≤ x ∧ x ≤ 3550)
    (hBari : 1656 ≤ x ∧ x ≤ 2970) : False := by omega

-- At 3sigma, Bari does admit part of B-high (its lower endpoint).
theorem bari_3sigma_keeps_Bhigh :
    (1422 : Int) ≤ 3200 ∧ 3200 ≤ 3510 ∧ 3200 ≤ 3550 := by omega

-- The COMPLETE 73-row NuFIT tabulation is evaluated; no missing rows.
theorem nufit_grid_excludes_Blow_at_nominal_3sigma :
    grid.all (fun p =>
      decide (5 ≤ p.1 ∧ p.1 ≤ 40 →
         (9000000000000 : Nat) < p.2)) = true := by
  decide +kernel

-- A recorded point in B-high is below the nominal 2sigma cutoff.
theorem nufit_grid_retains_Bhigh_at_nominal_2sigma :
    (320,3690221000000) ∈ grid ∧
    (3690221000000 : Nat) ≤ 4000000000000 := by
  constructor
  · exact witnessed_B_high
  · omega

theorem nufit_grid_retains_Bhigh_at_nominal_3sigma :
    (320,3690221000000) ∈ grid ∧
    (3690221000000 : Nat) ≤ 9000000000000 := by
  constructor
  · exact witnessed_B_high
  · omega

-- These are thin margins. Both are chi2 times 10^12 (exact integers).
theorem exact_Blow_3sigma_exclusion_margin :
    (9048116000000 : Nat) - 9000000000000 = 48116000000 := by omega

theorem exact_Bhigh_2sigma_inclusion_margin :
    (4000000000000 : Nat) - 3690221000000 = 309779000000 := by omega

-- Different reported decisions on B-high at nominal 2sigma.
def bariBhigh2 : Bool := decide ((3200 : Int) ≤ 2970)
def nufitBhigh2 : Bool := decide ((3690221000000 : Nat) ≤ 4000000000000)

theorem incompatible_2sigma_reports :
    bariBhigh2 = false ∧ nufitBhigh2 = true := by
  decide

end INSACERMO.JointBariNuFIT
