import C3.RecursiveTotalPlanKernelV1

/- INSACERMO C3 TOTAL executable certificate: four unknown laws, 3 physical probes,
   one deliberately ambiguous sensor. All 4 laws initially require activation.
   A Python exact minimax search EMITS a tree; Lean independently checks it and
   exhaustive infeasibility at smaller budgets via definitional reduction.
   The finite benchmark is illustrative, NOT proof of external-world coverage. -/
namespace INSACERMO.TotalExecutable

open INSACERMO.RecursiveC3
open INSACERMO.C3PP

abbrev St := Fin 4 × Bool
abbrev ActId := Fin 4
abbrev ProbeId := Fin 4

def scenarioGood (p : ActId) (s : St) : Prop :=
  s.2 = true ∧ p = s.1

def sensorSupport (q : ProbeId) (s : St) (o : Bool) : Prop :=
  if q.val = 0 then o = decide (s.1.val % 2 = 1)
  else if q.val = 1 then o = decide (s.1.val / 2 = 1)
  else if q.val = 2 then o = false
  else True

def changeState (q : ProbeId) (_o : Bool) (s : St) : St :=
  if q.val = 2 then (s.1, true) else s

def model : DynamicProblem St ActId ProbeId Bool where
  base := {
    allowed := fun _ => True
    probeAllowed := fun _ => True
    good := scenarioGood
    observes := sensorSupport
    actionCost := fun _ => 0
    probeCost := fun _ => 1
  }
  transform := changeState

def startingWorlds : St → Prop := fun s => s.2 = false

/-- Generated by solver.py from exact minimax search, not handcrafted by Lean. -/
def emitted : Plan ActId ProbeId Bool :=
  .probe (0 : Fin 4) (fun outcome => if outcome then (.probe (1 : Fin 4) (fun outcome => if outcome then (.probe (2 : Fin 4) (fun outcome => if outcome then (.act (0 : Fin 4)) else (.act (3 : Fin 4)))) else (.probe (2 : Fin 4) (fun outcome => if outcome then (.act (0 : Fin 4)) else (.act (1 : Fin 4)))))) else (.probe (1 : Fin 4) (fun outcome => if outcome then (.probe (2 : Fin 4) (fun outcome => if outcome then (.act (0 : Fin 4)) else (.act (2 : Fin 4)))) else (.probe (2 : Fin 4) (fun outcome => if outcome then (.act (0 : Fin 4)) else (.act (0 : Fin 4)))))))

set_option maxRecDepth 8192 in
set_option maxHeartbeats 15000000 in
theorem emitted_tree_is_verified :
    PlanValid model 3 3 startingWorlds emitted := by
  decide +kernel

/-- Exhaustive lower-bound check from the independently stated CanDynamic,
    not a claim from the Python generator. -/
set_option maxRecDepth 8192 in
set_option maxHeartbeats 15000000 in
theorem cannot_succeed_with_budget_two :
    ¬ CanDynamic model 3 2 startingWorlds := by
  decide +kernel

theorem emitted_tree_is_feasible :
    CanDynamic model 3 3 startingWorlds :=
  verified_plan_guarantees_feasibility model 3 3 startingWorlds
    emitted emitted_tree_is_verified

/-- A minimax certificate: feasible for budget 3, infeasible for all cheaper
    natural-number budgets. -/
theorem minimum_budget_is_three :
    OptimalBudget model 3 3 startingWorlds := by
  refine ⟨emitted_tree_is_feasible, ?_⟩
  intro k hk
  by_contra h
  have hsmall : k ≤ 2 := by omega
  exact cannot_succeed_with_budget_two
    (can_dynamic_budget_monotone model 3 k 2 startingWorlds hsmall hk)

/-- Sanity check: the ambiguous sensor never excludes any stated scenario. -/
theorem ambiguous_sensor_has_no_information :
    ∀ s : St, ∀ o : Bool,
      sensorSupport (3 : Fin 4) s o := by
  intro s o
  simp [sensorSupport]

end INSACERMO.TotalExecutable
